generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  name       String
  phone      String?
  role       String    @default("CUSTOMER") // "CUSTOMER" | "SHOP"
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  wallet     Wallet?
  shop       Shop?
  orders     Order[]   @relation("CustomerOrders")
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float         @default(100.0) // Initial ₹100 signup bonus
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // "CREDIT" | "DEBIT" | "REFUND"
  description String
  orderId     String?
  createdAt   DateTime @default(now())
}

model Shop {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  address         String
  phone           String
  upiId           String    @default("apexprint@upi")
  upiName         String?   @default("Apex QuickPrint Hub")
  qrImageUrl      String?   // Custom uploaded PhonePe / UPI QR image
  qrType          String    @default("DYNAMIC_UPI") // "DYNAMIC_UPI" | "CUSTOM_PHONEPE_IMAGE"
  bwSingleRate    Float     @default(2.0)
  bwDuplexRate    Float     @default(3.0)
  colorSingleRate Float     @default(10.0)
  colorDuplexRate Float     @default(18.0)
  autoConvert     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  printers        Printer[]
  orders          Order[]   @relation("ShopOrders")
}

model Printer {
  id             String   @id @default(uuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String
  port           Int      // e.g. 8001, 8002
  type           String   // "BW" | "COLOR"
  supportsDuplex Boolean  @default(true)
  isOnline       Boolean  @default(true)
  autoConvert    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  customerId        String
  customer          User        @relation("CustomerOrders", fields: [customerId], references: [id])
  shopId            String
  shop              Shop        @relation("ShopOrders", fields: [shopId], references: [id])
  status            String      @default("PENDING") // "PENDING" | "PRINTING" | "PRINTED" | "COLLECTED" | "CANCELLED"
  totalAmount       Float
  paymentMethod     String      @default("SHOP_UPI_QR") // "SHOP_UPI_QR" | "WALLET" | "RAZORPAY"
  paymentStatus     String      @default("PAID")   // "PAID" | "REFUNDED" | "FAILED"
  upiTransactionRef String?
  razorpayPaymentId String?
  paymentScreenshot String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]
}

model OrderItem {
  id               String    @id @default(uuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  originalFileName String
  storedFileName   String
  fileType         String
  fileSize         Int
  pageCount        Int       @default(1)
  calculatedPages  Int       @default(1)
  copies           Int       @default(1)
  colorMode        String    @default("BW")     // "BW" | "COLOR"
  duplexMode       String    @default("SINGLE") // "SINGLE" | "DUPLEX"
  orientation      String    @default("PORTRAIT") // "PORTRAIT" | "LANDSCAPE" | "AUTO"
  paperSize        String    @default("A4")       // "A4" | "A3" | "LETTER" | "LEGAL"
  quality          String    @default("NORMAL")   // "DRAFT" | "NORMAL" | "HIGH"
  pageRange        String    @default("ALL")
  scaling          String    @default("FIT")      // "FIT" | "ACTUAL"
  collate          Boolean   @default(true)
  itemPrice        Float     @default(0.0)
  status           String    @default("PENDING")  // "PENDING" | "PRINTING" | "PRINTED" | "FAILED"
  printedAt        DateTime?
  errorMessage     String?
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      String   @default("REGISTRATION")
  expiresAt DateTime
  createdAt DateTime @default(now())
}
