{
  "name": "printhub-shop-partner",
  "version": "1.0.0",
  "description": "PrintHub Shop Partner — Desktop Print Spooler & FIFO Queue",
  "main": "main.js",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "dev": "node node_modules/electron/cli.js .",
    "dist": "node node_modules/electron-builder/cli.js --win",
    "dist:dir": "node node_modules/electron-builder/cli.js --win --dir",
    "dist:portable": "node node_modules/electron-builder/cli.js --win portable",
    "dist:installer": "node node_modules/electron-builder/cli.js --win nsis"
  },
  "build": {
    "appId": "com.printhub.shoppartner",
    "productName": "PrintHub Shop Partner",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintHub Shop Partner"
    },
    "files": [
      "main.js",
      "preload.js",
      "client-dist/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/pdf-to-printer/**/*"
    ]
  },
  "keywords": [],
  "author": "PrintHub Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pdf-to-printer": "^5.8.1"
  }
}
